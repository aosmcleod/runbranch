<?xml version="1.0" encoding="utf-8"?>
<!--
  Runbranch — run any branch of any project on a real port.
  Copyright (C) 2026 Alec McLeod. GPL-3.0-or-later.

  longPathAware: worktrees sit under %USERPROFILE%\.runbranch\<project>\worktrees,
  and a node_modules inside one passes MAX_PATH quickly. The app only reads
  paths the engine prints, but it reads logs and reveals folders under there.
  (It also needs LongPathsEnabled in the registry; doctor says so.)

  PerMonitorV2: the window moves between displays of different scale, and
  anything less draws blurry on one of them.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Runbranch.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
