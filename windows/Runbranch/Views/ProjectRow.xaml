  A project in the sidebar: Views.swift's ProjectRow. The glyph goes in the
  NavigationViewItem's own icon slot (ProjectRow.Icon), so it sits on the same
  column as every other NavigationView's icons; this is the rest of the row —
  the name, and a spinner at the trailing edge while something runs.
-->
<UserControl
    x:Class="Runbranch.Views.ProjectRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid ColumnSpacing="{StaticResource RbSpacing}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            x:Name="NameText"
            VerticalAlignment="Center"
            Style="{StaticResource RbBodyTextStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <ProgressRing
            x:Name="Spinner"
            Grid.Column="1"
            Width="{StaticResource RbIconSize}"
            Height="{StaticResource RbIconSize}"
            MinWidth="0"
            MinHeight="0"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
