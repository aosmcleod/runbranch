  Copyright (C) 2026 Alec McLeod. GPL-3.0-or-later; see app/Engine.swift.

  Shown when no projects are declared: Views.swift's WelcomeView. The
  alternative was an empty sidebar beside an empty pane, which tells a
  first-time user nothing at all.

  The bare mark on the backdrop, not the app icon: inside the app the tile is
  redundant — the window already is the app.
-->
<UserControl
    x:Class="Runbranch.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        Padding="40,32"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Image
            x:Name="Mark"
            Width="{StaticResource RbMarkSize}"
            Height="{StaticResource RbMarkSize}"
            Margin="0,0,0,16" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Runbranch" />
        <TextBlock
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource RbSecondaryBrush}"
            Style="{StaticResource RbBodyTextStyle}"
            Text="Run any branch of any project, on a real port." />
        <TextBlock
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource RbTertiaryBrush}"
            Style="{StaticResource RbCaptionTextStyle}"
            Text="Isolated in a throwaway worktree, or in place in your checkout."
            TextAlignment="Center" />

        <!-- Both buttons the same width, so neither looks like the runt. -->
        <StackPanel
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{StaticResource RbSpacing}">
            <Button
                x:Name="ScanButton"
                Width="128"
                Content="Scan…"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="AddButton"
                Width="128"
                Content="Add a project…" />
        </StackPanel>

        <TextBlock
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource RbTertiaryBrush}"
            Style="{StaticResource RbCaptionTextStyle}"
            Text="Projects are plain config files you can commit to the repository."
            TextAlignment="Center" />
    </StackPanel>
</UserControl>
