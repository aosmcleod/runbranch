  SwiftUI's ContentUnavailableView, which WinUI has no stock control for: a
  glyph, a title and one line of what to do about it, centred in the pane.
-->
<UserControl
    x:Class="Runbranch.Views.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <StackPanel
        MaxWidth="400"
        Margin="{StaticResource RbPagePadding}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="{StaticResource RbSpacing}">
        <FontIcon
            x:Name="Glyph"
            Margin="0,0,0,4"
            HorizontalAlignment="Center"
            FontSize="{StaticResource RbDisplayIconSize}"
            Foreground="{ThemeResource RbSecondaryBrush}" />
        <TextBlock
            x:Name="TitleText"
            HorizontalAlignment="Center"
            FontSize="{StaticResource RbSubtitleFontSize}"
            FontWeight="SemiBold"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="MessageText"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource RbSecondaryBrush}"
            Style="{StaticResource RbBodyTextStyle}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
