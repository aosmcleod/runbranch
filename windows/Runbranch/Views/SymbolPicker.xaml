  A searchable grid of symbols, the way the SF Symbols picker works: icons
  only, no names. Views.swift's SymbolPicker, as a drop-down button and a
  flyout (ui-map §3.1): a search box over an 8-column grid.
-->
<UserControl
    x:Class="Runbranch.Views.SymbolPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Runbranch">
    <UserControl.Resources>
        <!-- 32 px cells, 4 px apart: eight across is 288 -->
        <x:Double x:Key="SymbolCellSize">32</x:Double>
        <x:Double x:Key="SymbolGridWidth">288</x:Double>
        <x:Double x:Key="SymbolGridHeight">240</x:Double>
        <Thickness x:Key="SymbolCellMargin">0,0,4,4</Thickness>
    </UserControl.Resources>

    <DropDownButton
        x:Name="Button"
        MinHeight="{StaticResource RbControlHeight}"
        Padding="{ThemeResource ButtonPadding}"
        AutomationProperties.Name="Sidebar icon"
        ToolTipService.ToolTip="Sidebar icon">
        <FontIcon x:Name="Current" FontSize="{StaticResource RbIconSize}" />
        <DropDownButton.Flyout>
            <Flyout x:Name="Popup" Placement="Bottom" Opened="OnOpened" Closed="OnClosed">
                <StackPanel Width="{StaticResource SymbolGridWidth}" Spacing="{StaticResource RbSpacing}">
                    <AutoSuggestBox x:Name="Search" PlaceholderText="Search" QueryIcon="Find"
                                    AutomationProperties.Name="Search symbols" TextChanged="OnSearch" />
                    <GridView
                        x:Name="Grid"
                        Height="{StaticResource SymbolGridHeight}"
                        IsItemClickEnabled="True"
                        ItemClick="OnPicked"
                        SelectionMode="Single">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="8" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Width" Value="{StaticResource SymbolCellSize}" />
                                <Setter Property="Height" Value="{StaticResource SymbolCellSize}" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="{StaticResource SymbolCellMargin}" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <!-- The name is there if you want it -->
                                <FontIcon local:Icons.Symbol="{x:Bind}" FontSize="{StaticResource RbIconSize}"
                                          ToolTipService.ToolTip="{x:Bind}" AutomationProperties.Name="{x:Bind}" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock x:Name="None" Style="{StaticResource RbCaptionTextStyle}" Visibility="Collapsed" />
                </StackPanel>
            </Flyout>
        </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>
