  One branch in the list: Views.swift's BranchRow on the F6 grid.

  Two fixed lines, whatever the row holds, so every row in the list is the
  same height and the trailing column lines up down the whole list: a body
  line (20, the Fluent body line height) for the name, badges and age, and a
  caption line (16) for the subject and the divergence. A row without a
  subject keeps its second line empty rather than collapsing — a list whose
  rows are two heights reads as two lists.
-->
<UserControl
    x:Class="Runbranch.Views.BranchRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Runbranch.Views"
    IsTabStop="False">
    <Grid
        Padding="{StaticResource RbRowPadding}"
        ColumnSpacing="{StaticResource RbSpacing}"
        RowDefinitions="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The gutter: reserved whenever anything runs, so names stay on one
             vertical line instead of the live row shunting itself sideways. -->
        <Grid
            x:Name="Gutter"
            Width="{StaticResource RbIconSize}"
            Height="{StaticResource RbIconSize}"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <ProgressRing
                x:Name="Spinner"
                Width="{StaticResource RbIconSize}"
                Height="{StaticResource RbIconSize}"
                MinWidth="0"
                MinHeight="0"
                IsActive="False" />
        </Grid>

        <views:LinePanel
            x:Name="Line"
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="{StaticResource RbSpacing}" />

        <TextBlock
            x:Name="Subject"
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource RbCaptionTextStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <TextBlock
            x:Name="Age"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Style="{StaticResource RbCaptionTextStyle}"
            TextLineBounds="Tight" />

        <TextBlock
            x:Name="Divergence"
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontSize="{StaticResource RbCaptionFontSize}"
            Foreground="{ThemeResource RbTertiaryBrush}" />
    </Grid>
</UserControl>
