<dialogs:SheetDialog
    x:Class="Runbranch.Dialogs.PortConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Runbranch.Dialogs"
    xmlns:local="using:Runbranch">
    <dialogs:SheetDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/SheetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:SheetDialog.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SheetHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon local:Icons.Symbol="exclamationmark.triangle" Style="{StaticResource SheetHeaderIconStyle}"
                      Foreground="{ThemeResource RbOrangeBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Ports already in use" Style="{StaticResource SheetTitleTextStyle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource SheetSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SheetDividerStyle}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource SheetBandPadding}" Spacing="{StaticResource RbSpacing}">
                <ItemsRepeater x:Name="Clashes">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="{StaticResource RbSpacing}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ClashRow">
                            <Grid ColumnSpacing="{StaticResource RbSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Target}" Style="{StaticResource RbBodyStrongTextStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Port}" Style="{StaticResource RbBodyTextStyle}"
                                           FontFamily="{StaticResource RbMonoFontFamily}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Description}" Style="{StaticResource RbCaptionTextStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock x:Name="Caveat" Style="{StaticResource RbCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource SheetFooterStyle}">
            <Grid>
                <Button x:Name="Cancel" Content="Cancel" Style="{StaticResource SheetButtonStyle}" Click="OnCancelClick" />
                <StackPanel Style="{StaticResource SheetFooterButtonsStyle}">
                    <Button x:Name="Shift" Style="{StaticResource SheetButtonStyle}" Visibility="Collapsed" Click="OnShift" />
                    <!-- Stopping a run of ours is the routine resolution, and
                         still destructive enough to be red. -->
                    <Button x:Name="Switch" Content="Stop and switch" Style="{StaticResource SheetDestructiveButtonStyle}"
                            Visibility="Collapsed" Click="OnSwitch" />
                    <!-- A server something else started. Offered, because
                         refusing outright is unhelpful when it is plainly the
                         same project — but never the default action, and it
                         says what it will end rather than hiding behind a verb. -->
                    <Button x:Name="TakeOver" Style="{StaticResource SheetDestructiveButtonStyle}" Visibility="Collapsed"
                            ToolTipService.ToolTip="Ends the process listed above, then starts this run" Click="OnTakeOver" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dialogs:SheetDialog>
