  About Runbranch: App.swift's AboutView, 340 wide and as tall as it needs.
  The same shape as the system about panels — icon, name, version, then the
  small print — because that shape is what people recognise.
-->
<dialogs:SheetDialog
    x:Class="Runbranch.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Runbranch.Dialogs"
    xmlns:views="using:Runbranch.Views">
    <dialogs:SheetDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/SheetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="AboutMarkSize">128</x:Double>
            <Thickness x:Key="AboutPadding">16,24,16,16</Thickness>
            <Style x:Key="AboutLineStyle" TargetType="TextBlock" BasedOn="{StaticResource RbCaptionTextStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </dialogs:SheetDialog.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="{StaticResource AboutPadding}" Spacing="{StaticResource RbSpacing}" HorizontalAlignment="Center">
            <Image x:Name="Mark" Width="{StaticResource AboutMarkSize}" Height="{StaticResource AboutMarkSize}" HorizontalAlignment="Center" />
            <TextBlock Text="Runbranch" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="Version" Style="{StaticResource SheetSecondaryTextStyle}" HorizontalAlignment="Center" />
            <!-- Only on a development build, and only then. A release should
                 say nothing about a distinction its user has no reason to
                 know about. -->
            <views:Badge x:Name="DevBadge" Text="development build" Symbol="hammer.fill" Tone="Orange"
                         HorizontalAlignment="Center" Visibility="Collapsed" />
            <StackPanel Margin="{StaticResource SheetSectionMargin}">
                <TextBlock Text="Created by Alec McLeod" Style="{StaticResource AboutLineStyle}" />
                <TextBlock Text="GPL-3.0 — free to use, change and share alike" Style="{StaticResource AboutLineStyle}" />
            </StackPanel>
            <HyperlinkButton x:Name="Repo" Content="Runbranch on GitHub" HorizontalAlignment="Center" Style="{StaticResource SheetLinkStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SheetFooterStyle}">
            <StackPanel Style="{StaticResource SheetFooterButtonsStyle}">
                <Button x:Name="Done" Content="Close" Style="{StaticResource SheetAccentButtonStyle}" Click="OnDone" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:SheetDialog>
