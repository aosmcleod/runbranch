  What is on every declared port, across every project: Ports.swift's
  PortsSheet, 520 x 460.
-->
<dialogs:SheetDialog
    x:Class="Runbranch.Dialogs.PortsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Runbranch.Dialogs"
    xmlns:local="using:Runbranch"
    xmlns:views="using:Runbranch.Views">
    <dialogs:SheetDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/SheetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:SheetDialog.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SheetHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon local:Icons.Symbol="network" Style="{StaticResource SheetHeaderIconStyle}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Ports" Style="{StaticResource SheetTitleTextStyle}" />
                <TextBlock Text="Every port your projects declare, and what is on it" Style="{StaticResource SheetSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SheetDividerStyle}" />

        <ProgressRing x:Name="Spinner" Grid.Row="2" Width="{StaticResource RbIconSize}" Height="{StaticResource RbIconSize}" IsActive="True" />
        <TextBlock x:Name="Empty" Grid.Row="2" Text="No ports declared yet." Style="{StaticResource SheetSecondaryTextStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <ScrollViewer x:Name="List" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsRepeater x:Name="Rows">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:PortRowView">
                        <StackPanel>
                            <Grid Padding="{StaticResource SheetRowPadding}" ColumnSpacing="{StaticResource RbSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Port}" Style="{StaticResource SheetPortTextStyle}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource RbSpacing}">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource RbBodyTextStyle}" />
                                        <views:Badge Text="{x:Bind Badge.Text}" Symbol="{x:Bind Badge.Symbol}" Tone="{x:Bind Badge.Tone}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind What}" Visibility="{x:Bind WhatVisibility}" Style="{StaticResource SheetMonoCaptionStyle}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SheetRowDividerStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Ports two projects both want. Shown here and not on the project
             rows in the sidebar: nothing is wrong until you try to run the
             second one, and a warning on a project that merely might clash
             cried wolf on every row. -->
        <StackPanel x:Name="Overlaps" Grid.Row="3" Visibility="Collapsed">
            <Border Style="{StaticResource SheetDividerStyle}" />
            <StackPanel Padding="{StaticResource SheetBandPadding}" Spacing="{StaticResource RbSpacing}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource RbSpacing}">
                    <FontIcon local:Icons.Symbol="arrow.triangle.branch" FontSize="{StaticResource RbBadgeIconSize}"
                              Foreground="{ThemeResource RbOrangeBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="OverlapHeading" Style="{StaticResource RbBodyStrongTextStyle}" />
                </StackPanel>
                <StackPanel x:Name="OverlapRows" Spacing="{StaticResource RbSpacing}" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="Problem" Grid.Row="4" Margin="{StaticResource SheetInfoBarMargin}" Severity="Error" IsOpen="False" />

        <Border Grid.Row="5" Style="{StaticResource SheetFooterStyle}">
            <StackPanel Style="{StaticResource SheetFooterButtonsStyle}">
                <Button x:Name="Done" Content="Done" Style="{StaticResource SheetAccentButtonStyle}" Click="OnDone" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:SheetDialog>
