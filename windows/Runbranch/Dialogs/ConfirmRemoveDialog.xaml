  "Remove <name>?" — ContentView.swift's confirmationDialog.

  A footer of its own rather than ContentDialog's buttons. The stock ones are
  laid out Primary, Secondary, Close from left to right, and accent whichever
  is the default: with Remove as the primary and Cancel as the default, that
  put the red Remove on the left and a blue Cancel on the right — the opposite
  of every other sheet here. Cancel is never the accented button, and the
  action a sheet exists for is always rightmost; when that action destroys
  something, it is the red one.
-->
<dialogs:SheetDialog
    x:Class="Runbranch.Dialogs.ConfirmRemoveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Runbranch.Dialogs">
    <dialogs:SheetDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/SheetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:SheetDialog.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="{StaticResource SheetBandPadding}" Spacing="{StaticResource RbSpacing}">
            <TextBlock x:Name="Heading" Style="{StaticResource SheetTitleTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="Deletes this project's config file and any worktrees, logs and ports Runbranch created for it."
                       Style="{StaticResource SheetSecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="Untouched" Style="{StaticResource SheetSecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SheetFooterStyle}">
            <StackPanel Style="{StaticResource SheetFooterButtonsStyle}">
                <Button x:Name="Cancel" Content="Cancel" Style="{StaticResource SheetButtonStyle}" Click="OnCancelClick" />
                <Button x:Name="Remove" Content="Remove project" Style="{StaticResource SheetDestructiveButtonStyle}" Click="OnRemove" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:SheetDialog>
