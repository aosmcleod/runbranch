<dialogs:SheetDialog
    x:Class="Runbranch.Dialogs.RunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Runbranch.Dialogs"
    xmlns:local="using:Runbranch">
    <dialogs:SheetDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/SheetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:SheetDialog.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SheetHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="{StaticResource RbIconSize}" Height="{StaticResource RbIconSize}" VerticalAlignment="Center">
                <ProgressRing x:Name="Spinner" Width="{StaticResource RbIconSize}" Height="{StaticResource RbIconSize}" IsActive="True" />
                <FontIcon x:Name="Succeeded" local:Icons.Symbol="checkmark.circle.fill" FontSize="{StaticResource RbIconSize}"
                          Foreground="{ThemeResource RbGreenBrush}" Visibility="Collapsed" />
                <FontIcon x:Name="Failed" local:Icons.Symbol="xmark.circle.fill" FontSize="{StaticResource RbIconSize}"
                          Foreground="{ThemeResource RbRedBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="Headline" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SheetTitleTextStyle}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SheetDividerStyle}" />

        <ScrollViewer x:Name="Scroller" Grid.Row="2" Padding="{StaticResource SheetBandPadding}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="Lines">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource RbMonoTextStyle}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource SheetFooterStyle}">
            <Grid>
                <Button x:Name="CopyLog" Content="Copy log" Style="{StaticResource SheetButtonStyle}"
                        Visibility="Collapsed" Click="OnCopyLog" />
                <StackPanel Style="{StaticResource SheetFooterButtonsStyle}">
                    <!-- The only button while a command runs, and it ends that
                         command: the sheet's primary action, and a destructive one,
                         so red. Close replaces it when the command finishes. -->
                    <Button x:Name="StopButton" Content="Stop" Style="{StaticResource SheetDestructiveButtonStyle}" Click="OnStop" />
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SheetAccentButtonStyle}"
                            Visibility="Collapsed" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dialogs:SheetDialog>
