  Offered when there is a newer release, and the place the whole install
  happens: progress, failure and the way out all stay on this one sheet.
  Updates.swift's UpdateSheet, 520 x 440 with notes, 520 x 260 without.
-->
<dialogs:SheetDialog
    x:Class="Runbranch.Dialogs.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:Runbranch.Dialogs"
    xmlns:local="using:Runbranch"
    xmlns:views="using:Runbranch.Views">
    <dialogs:SheetDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Dialogs/SheetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:SheetDialog.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SheetHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="Mark" Width="{StaticResource SheetMarkSize}" Height="{StaticResource SheetMarkSize}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Style="{StaticResource SheetTitleTextStyle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource SheetSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SheetDividerStyle}" />

        <ScrollViewer x:Name="NotesScroller" Grid.Row="2" Padding="{StaticResource SheetBandPadding}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <views:NotesText x:Name="Notes" />
        </ScrollViewer>
        <StackPanel x:Name="Status" Grid.Row="2" Style="{StaticResource SheetStatePanelStyle}">
            <Grid HorizontalAlignment="Center">
                <FontIcon x:Name="StatusIcon" Style="{StaticResource SheetStateIconStyle}" />
                <ProgressRing x:Name="Checking" Width="{StaticResource SheetStateIconSize}" Height="{StaticResource SheetStateIconSize}"
                              IsActive="False" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="StatusLine" Style="{StaticResource SheetStateTextStyle}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource SheetFooterStyle}">
            <Grid ColumnSpacing="{StaticResource RbSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Downloading, checking the download, installing -->
                <StackPanel x:Name="Working" Grid.ColumnSpan="2" Spacing="{StaticResource RbSpacingSmall}" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar x:Name="Progress" Maximum="1" />
                    <TextBlock x:Name="WorkingText" Style="{StaticResource RbCaptionTextStyle}" />
                </StackPanel>

                <!-- Plain and on the left, because it is the one action here
                     nobody is looking for and it should not compete with the
                     two that they are. -->
                <HyperlinkButton x:Name="TurnOff" Content="Turn off update checks" VerticalAlignment="Center" Style="{StaticResource SheetLinkStyle}"
                                 FontSize="{StaticResource RbCaptionFontSize}" Visibility="Collapsed" Click="OnTurnOff" />
                <TextBlock x:Name="Why" VerticalAlignment="Center" Style="{StaticResource RbCaptionTextStyle}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

                <StackPanel Grid.Column="1" Style="{StaticResource SheetFooterButtonsStyle}">
                    <Button x:Name="OpenReleases" Content="Open releases" Style="{StaticResource SheetButtonStyle}" Visibility="Collapsed"
                            Click="OnOpenReleases" />
                    <Button x:Name="Later" Content="Later" Style="{StaticResource SheetButtonStyle}" Visibility="Collapsed" Click="OnClose" />
                    <Button x:Name="Install" Content="Update" Style="{StaticResource SheetAccentButtonStyle}" Visibility="Collapsed"
                            Click="OnInstall" />
                    <Button x:Name="Close" Content="Done" Style="{StaticResource SheetAccentButtonStyle}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dialogs:SheetDialog>
