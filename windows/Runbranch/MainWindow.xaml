  Copyright (C) 2026 Alec McLeod. GPL-3.0-or-later; see app/Engine.swift.

  The main window: ContentView.swift's port (spec 6.2). Mica behind a title
  bar that carries what the Mac's unified toolbar carries — title, subtitle,
  sidebar toggle, search, and the filter / refresh / ••• buttons — over a
  NavigationView whose pane is the sidebar and whose content is the detail.

  The code is split by area, as ContentView is by section:
    MainWindow.xaml.cs          shell, launch, timers, shortcuts
    MainWindow.Sidebar.cs       Running / Favourites / Projects
    MainWindow.Detail.cs        snapshot, cache, selection, list, strip, action bar
    MainWindow.Toolbar.cs       title bar, search, filter and ••• menus
    MainWindow.Flow.cs          start flow, port resolution, streamed runs
-->
<Window
    x:Class="Runbranch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:Runbranch.Views"
    Title="Runbranch">

    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <Grid.Resources>
          <ResourceDictionary>
            <!-- The caption buttons' colours, per theme (MainWindow.Theme.cs):
                 the system draws those buttons and cannot see this window's
                 theme, so they are told. The same resources a subtle button
                 uses, so they match the title bar's own buttons. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RbCaptionForeground" Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="RbCaptionPressedForeground" Color="{ThemeResource TextFillColorSecondary}" />
                    <SolidColorBrush x:Key="RbCaptionInactiveForeground" Color="{ThemeResource TextFillColorTertiary}" />
                    <SolidColorBrush x:Key="RbCaptionHoverBackground" Color="{ThemeResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="RbCaptionPressedBackground" Color="{ThemeResource SubtleFillColorTertiary}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RbCaptionForeground" Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="RbCaptionPressedForeground" Color="{ThemeResource TextFillColorSecondary}" />
                    <SolidColorBrush x:Key="RbCaptionInactiveForeground" Color="{ThemeResource TextFillColorTertiary}" />
                    <SolidColorBrush x:Key="RbCaptionHoverBackground" Color="{ThemeResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="RbCaptionPressedBackground" Color="{ThemeResource SubtleFillColorTertiary}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The header's buttons are one set with the caption buttons:
                 they butt against them and each other, and are as wide and as
                 tall as a caption button (width measured at runtime,
                 MainWindow.Toolbar.cs). The title bar's own padding goes, so
                 the pane toggle is flush left and the last button flush
                 against minimise; the drag region is what the title leaves. -->
            <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
            <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            <!-- Square, borderless, transparent: a caption button's shape. A
                 subtle button's hover and pressed fills are already the
                 caption buttons' (SubtleFillColorSecondary / Tertiary, the
                 same resources RbCaptionHoverBackground and
                 RbCaptionPressedBackground read), as is its foreground. -->
            <Style x:Key="RbToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>            <Style x:Key="RbBranchItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ResourceDictionary>
        </Grid.Resources>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Runbranch"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="TitleIcon" />
            </TitleBar.IconSource>
            <!-- The pane toggle is ours rather than the title bar's, so it can
                 be the same shape as the buttons on the right. -->
            <TitleBar.LeftHeader>
                <Button
                    x:Name="PaneButton"
                    AutomationProperties.Name="Show or hide the sidebar"
                    Style="{StaticResource RbToolbarButtonStyle}"
                    ToolTipService.ToolTip="Show or hide the sidebar">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="{StaticResource RbIconSize}"
                        Glyph="&#xE700;" />
                </Button>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel x:Name="ToolbarButtons" Orientation="Horizontal">
                    <!-- A normal text field, centred in the bar; the gap after
                         it separates a field from a row of buttons. -->
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="320"
                        Height="32"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        PlaceholderText="Search branches"
                        QueryIcon="Find" />
                    <Button
                        x:Name="SearchButton"
                        AutomationProperties.Name="Search branches"
                        Style="{StaticResource RbToolbarButtonStyle}"
                        ToolTipService.ToolTip="Search branches"
                        Visibility="Collapsed">
                        <FontIcon x:Name="SearchGlyph" FontSize="{StaticResource RbIconSize}" />
                    </Button>
                    <Button
                        x:Name="FilterButton"
                        AutomationProperties.Name="Filter branches"
                        Style="{StaticResource RbToolbarButtonStyle}"
                        ToolTipService.ToolTip="Filter branches">
                        <FontIcon x:Name="FilterGlyph" FontSize="{StaticResource RbIconSize}" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="FilterMenu" Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Re-read branches and pull request state"
                        Style="{StaticResource RbToolbarButtonStyle}"
                        ToolTipService.ToolTip="Re-read branches and pull request state">
                        <FontIcon x:Name="RefreshGlyph" FontSize="{StaticResource RbIconSize}" />
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.Name="More actions"
                        Style="{StaticResource RbToolbarButtonStyle}"
                        ToolTipService.ToolTip="More actions">
                        <FontIcon x:Name="MoreGlyph" FontSize="{StaticResource RbIconSize}" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <views:WelcomeView
            x:Name="Welcome"
            Grid.Row="1"
            Visibility="Collapsed" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="240"
            PaneDisplayMode="Left">

            <Grid x:Name="DetailRoot">
                <views:EmptyState x:Name="NoProject" Visibility="Collapsed" />

                <ProgressRing
                    x:Name="Loading"
                    Width="{StaticResource RbIconSize}"
                    Height="{StaticResource RbIconSize}"
                    MinWidth="0"
                    MinHeight="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <Grid x:Name="Detail" RowDefinitions="Auto,*,Auto" Visibility="Collapsed">
                    <views:RunStrip
                        x:Name="Strip"
                        Margin="16,16,16,0"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="BranchList"
                        Grid.Row="1"
                        Padding="0,8"
                        ItemContainerStyle="{StaticResource RbBranchItemStyle}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="views:BranchItem">
                                <views:BranchRow Item="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <views:EmptyState
                        x:Name="NoBranches"
                        Grid.Row="1"
                        Visibility="Collapsed" />

                    <!-- Nothing selected means nothing to press, and an empty
                         bar with a separator above it reads as a broken
                         control rather than an absent one. -->
                    <Border
                        x:Name="ActionBar"
                        Grid.Row="2"
                        Padding="16,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="{StaticResource RbSpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Its segments are equal width already, which is
                                 what the Mac's count × 72 was for. -->
                            <toolkit:Segmented
                                x:Name="PresetPicker"
                                Height="{StaticResource RbControlHeight}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="{StaticResource RbSpacing}">
                                <Button x:Name="LogsButton" Content="Logs" />
                                <Button x:Name="OpenButton" Content="Open" />
                                <Button x:Name="UpdateButton" Content="Update" />
                                <Button x:Name="PrimaryButton" MinWidth="80" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
