<!--
  Runbranch — run any branch of any project on a real port.
  Copyright (C) 2026 Alec McLeod. GPL-3.0-or-later; see app/Engine.swift.

  Tokens.xaml comes after the stock resources on purpose: a later merged
  dictionary wins, which is how its grid overrides (13 px text, 28 px
  controls) reach every stock control without restyling each one.
-->
<Application
    x:Class="Runbranch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
