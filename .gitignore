build/
demo/

# Project definitions are personal: they name real repositories on a real
# machine, and the author's are nobody else's starting state. The engine reads
# this directory by default, so they live here — untracked. example.conf is the
# one that ships.
projects/*.conf
!projects/example.conf
Runbranch.app/
.DS_Store

# Everything in assets/ except the vector masters is rendered by make-icons.sh
# from assets/mark.svg. Tracking a generated PNG next to the vector it comes
# from is how the two drifted apart in the first place.
assets/mark.png
assets/AppIcon.icon/
dist/
